{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoleSweep",
  "version": "0.1.0",
  "identifier": "com.bryan.molesweep",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MoleSweep",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#1f2227"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
